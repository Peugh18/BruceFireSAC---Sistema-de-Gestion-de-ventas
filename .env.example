APP_NAME="Bruce Fire"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=es
APP_FALLBACK_LOCALE=es
APP_FAKER_LOCALE=es_PE

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=bruce_fire
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# --- Facturación electrónica SUNAT (Greenter) ---
SUNAT_BETA=true
SUNAT_RUC=
SUNAT_USUARIO_SOL=
SUNAT_CLAVE_SOL=
SUNAT_CERT_PATH=
SUNAT_CERT_PASSWORD=
SUNAT_GRE_CLIENT_ID=
SUNAT_GRE_CLIENT_SECRET=

BILLING_ENVIO_DIFERIDO_HORAS=6
BILLING_COMPANY_RUC=
BILLING_COMPANY_RAZON_SOCIAL="BRUCE FIRE S.A.C."
BILLING_COMPANY_NOMBRE_COMERCIAL="BRUCE FIRE"
BILLING_COMPANY_UBIGEO=
BILLING_COMPANY_DEPARTAMENTO=
BILLING_COMPANY_PROVINCIA=
BILLING_COMPANY_DISTRITO=
BILLING_COMPANY_DIRECCION=

# PENDIENTE de confirmar con el contable: 020 (mantenimiento/reparación de bienes
# muebles) | 022 (otros servicios) | 037 (residual). No cambiar sin confirmar.
BILLING_DETRACCION_CODIGO_BIEN=020

# APIsPeru (consulta RUC/DNI para validar Activo + Hábido)
APISPERU_TOKEN=

CHISPA_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# --- Producción (copiar valores al entorno del servidor; no guardar secretos aquí) ---
# APP_ENV=production
# APP_DEBUG=false
# APP_URL=https://sistema.ejemplo.com
# DB_CONNECTION=mysql
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=
# DB_USERNAME=
# DB_PASSWORD=
# QUEUE_CONNECTION=database
